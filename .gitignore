# JavaScript / frontend dependencies and build outputs
node_modules/
dist/
dist-ssr/
coverage/

# Python virtual environments, caches, and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
backend/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment variables and secrets
.env
.env.*
.env.local
!.env.example
!*.example
!**/.env.*.example

# Editors and operating-system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.idea/
.vscode/*
!.vscode/extensions.json

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Generated processing outputs (preserve directory with .gitkeep)
backend/storage/jobs/*
!backend/storage/jobs/.gitkeep
backend/storage/*.lock
backend/storage/.*.lock
