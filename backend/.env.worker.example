# ==============================================================================
# SURFACE Worker Node Environment Configuration Template
# ==============================================================================
# Role: Worker Node (Celery Worker executing batch classification & pipeline stages)
# Deployment Target: Ubuntu VM 2 (e.g. 192.168.56.11)
#
# Instructions:
#   1. Copy this template to backend/.env.worker (or backend/.env):
#        cp backend/.env.worker.example backend/.env.worker
#   2. Replace all placeholder values (<MASTER_VM_IP>, passwords).
#   3. Ensure values marked [MUST MATCH] are identical to Master VM settings.
#   4. Restrict file permissions: chmod 600 backend/.env.worker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution Mode [MUST MATCH: Set to 'celery' on all distributed workers]
# ------------------------------------------------------------------------------
# Options: 'celery' | 'local'
# Workers must run with 'celery' to connect to the shared Redis task queue.
SURFACE_EXECUTION=celery

# ------------------------------------------------------------------------------
# 2. Redis Broker and Result Backend URL [MUST MATCH Master's Redis settings]
# ------------------------------------------------------------------------------
# Points to the Redis instance running on Master VM 1 (<MASTER_VM_IP>).
# Format: redis://[:password@]host[:port][/db]
# CRITICAL: Credentials, port, and DB index must match Master VM 1 configuration.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@<MASTER_VM_IP>:6379/0

# ------------------------------------------------------------------------------
# 3. Master API URL [MUST MATCH: Points to Master VM 1]
# ------------------------------------------------------------------------------
# Base URL for the master FastAPI HTTP service.
# The worker uses this to fetch manifests, download inputs, send heartbeats,
# claim batches, commit probabilities, and upload output artifacts.
SURFACE_MASTER_URL=http://<MASTER_VM_IP>:8000

# ------------------------------------------------------------------------------
# 4. Worker Shared Secret Token [MUST MATCH EXACTLY the Master Token]
# ------------------------------------------------------------------------------
# Must match the SURFACE_WORKER_TOKEN configured on Master VM 1.
# Transmitted in header X-Worker-Token and verified by master before any operation.
SURFACE_WORKER_TOKEN=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_TOKEN

# ------------------------------------------------------------------------------
# 5. Worker Identity [Machine-Specific: Unique worker identifier]
# ------------------------------------------------------------------------------
# Unique node name identifying this worker process on the cluster Nodes dashboard.
# Recommended: worker-<hostname> or worker-node-2.
SURFACE_WORKER_NAME=worker-ubuntu-node2

# ------------------------------------------------------------------------------
# 6. Model Checkpoint Path [Verified Repository Checkpoint]
# ------------------------------------------------------------------------------
# Path to the local copy of the EfficientNet-B0 weights on this worker machine.
SURFACE_MODEL_PATH=backend/model_store/best_model_sdnet2018.pth

# ------------------------------------------------------------------------------
# 7. Worker Pipeline Tuning Parameters (Optional - Safe Defaults Shown)
# ------------------------------------------------------------------------------
# SURFACE_CRACK_THRESHOLD=0.5
# SURFACE_TILE_SIZE=256
# SURFACE_HEARTBEAT_INTERVAL=10.0
