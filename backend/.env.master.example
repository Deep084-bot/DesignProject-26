# ==============================================================================
# SURFACE Master Node Environment Configuration Template
# ==============================================================================
# Role: Master Node (FastAPI Master + Redis Broker + Recovery Supervisor)
# Deployment Target: Ubuntu VM 1 (e.g. 192.168.56.10)
#
# Instructions:
#   1. Copy this template to backend/.env.master (or backend/.env):
#        cp backend/.env.master.example backend/.env.master
#   2. Replace all placeholder values (<MASTER_VM_IP>, <WINDOWS_HOST_IP>, passwords).
#   3. Ensure values marked [MUST MATCH] are identical on Master and Worker.
#   4. Restrict file permissions: chmod 600 backend/.env.master
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution Mode [MUST MATCH: Set to 'celery' for distributed multi-VM]
# ------------------------------------------------------------------------------
# Options: 'celery' (distributed via Redis broker) | 'local' (single-process thread pool)
# Default: 'local' (backward-compatible offline mode)
SURFACE_EXECUTION=celery

# ------------------------------------------------------------------------------
# 2. Redis Broker and Result Backend URL [MUST MATCH credentials & DB index]
# ------------------------------------------------------------------------------
# Format: redis://[:password@]host[:port][/db]
# On the Master VM, Redis runs locally so loopback (127.0.0.1) or VM IP can be used.
# Security Note: Use an authenticated Redis instance. In /etc/redis/redis.conf, set:
#   bind 127.0.0.1 <MASTER_VM_IP>
#   requirepass <YOUR_REDIS_PASSWORD>
#   protected-mode yes
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 3. Master API URL [Machine-Specific: Externally reachable Master URL]
# ------------------------------------------------------------------------------
# The HTTP URL where workers reach the master API for manifest and artifact transfers.
# Replace <MASTER_VM_IP> with VM 1's network address (e.g., http://192.168.56.10:8000).
SURFACE_MASTER_URL=http://<MASTER_VM_IP>:8000

# ------------------------------------------------------------------------------
# 4. Worker Shared Secret Token [MUST MATCH EXACTLY on Master and all Workers]
# ------------------------------------------------------------------------------
# Shared secret for internal coordinator, batch, and finalizer route authentication.
# Master validates incoming requests via secrets.compare_digest in header X-Worker-Token.
# CRITICAL: If unset or mismatched, all internal worker requests are rejected with HTTP 403.
SURFACE_WORKER_TOKEN=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_TOKEN

# ------------------------------------------------------------------------------
# 5. Worker Identity [Machine-Specific: Identifier for local worker/coordinator]
# ------------------------------------------------------------------------------
# Descriptive name for coordinator or worker tasks running on this master node.
SURFACE_WORKER_NAME=master-coordinator

# ------------------------------------------------------------------------------
# 6. CORS Allowed Origins [Machine-Specific: Host Browser Development URL]
# ------------------------------------------------------------------------------
# Comma-separated list of browser origins permitted to query the API.
# Must include the Windows Host IP address running the Vite development server (port 5173).
SURFACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://<WINDOWS_HOST_IP>:5173

# ------------------------------------------------------------------------------
# 7. Model Checkpoint Path [Verified Repository Checkpoint]
# ------------------------------------------------------------------------------
# Path to the EfficientNet-B0 surface crack classification weights.
SURFACE_MODEL_PATH=backend/model_store/best_model_sdnet2018.pth

# ------------------------------------------------------------------------------
# 8. Pipeline and Recovery Tuning Parameters (Optional - Safe Defaults Shown)
# ------------------------------------------------------------------------------
# SURFACE_CRACK_THRESHOLD=0.5
# SURFACE_TILE_SIZE=256
# SURFACE_DEV_K=3.0
# SURFACE_DEV_MIN_MM=5.0
# SURFACE_DEV_MIN_AREA_PX=200
# SURFACE_MESH_DEPTH=8
# SURFACE_HEARTBEAT_INTERVAL=10.0
# SURFACE_LEASE_TIMEOUT=35.0
# SURFACE_SUPERVISOR_INTERVAL=5.0
# SURFACE_OFFLINE_GRACE_PERIOD=15.0
